" linux-env: native Vim, usable offline, without a network plugin manager.
set nocompatible
set encoding=utf-8
set nomodeline
set noexrc
" Keep archived ~/.vim plugins out of this profile without deleting them.
" Opt-in personal runtime files belong under ~/.config/linux-env/vim instead.
let s:personal_runtime = expand('~/.config/linux-env/vim')
" Load only this apt-managed diagnostic plugin, keeping old ~/.vim isolated.
let s:diagnostic_runtime = filereadable('/usr/share/vim-ale/plugin/ale.vim') ? '/usr/share/vim-ale,' : ''
let &runtimepath = escape(s:personal_runtime, ',') . ','
            \ . s:diagnostic_runtime
            \ . escape($VIMRUNTIME, ',') . ','
            \ . escape(s:personal_runtime . '/after', ',')
let &packpath = &runtimepath
filetype plugin indent on
syntax enable

set number
set cursorline
set cursorcolumn
" Underline the cursor row and shade its column, keeping syntax colors. Reapply
" when a personal colorscheme or a light/dark background is selected later.
function! s:CursorGuides() abort
    highlight CursorLine term=underline cterm=underline ctermbg=NONE ctermfg=NONE gui=underline guibg=NONE guifg=NONE
    if &background ==# 'dark'
        highlight CursorColumn cterm=NONE ctermbg=237 ctermfg=NONE gui=NONE guibg=#303744 guifg=NONE
    else
        highlight CursorColumn cterm=NONE ctermbg=252 ctermfg=NONE gui=NONE guibg=#dce2eb guifg=NONE
    endif
endfunction
call s:CursorGuides()
augroup linux_env_cursor_guides
    autocmd!
    autocmd ColorScheme * call <SID>CursorGuides()
    autocmd OptionSet background call <SID>CursorGuides()
augroup END
set ruler
set showcmd
set laststatus=2
set signcolumn=yes
set hidden
set mouse=a
set backspace=indent,eol,start
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4
set autoindent
set smartcase
set ignorecase
set incsearch
set hlsearch
set wildmenu
set wildmode=longest:full,full
set wildignore+=*/.git/*,*/.venv/*,*/build/*,*.o,*.pyc
set splitright
set splitbelow
set scrolloff=5
set updatetime=300
set showmode
set statusline=%f\ %h%m%r%=%{&filetype}\ %l:%c\ %p%%
" Use normal project tags, searching upward; do not index /usr/include at startup.
set tags=./tags;,tags
set path=.,include,src,/usr/local/include,/usr/include

let mapleader = ' '
nnoremap <leader>w :write<CR>
nnoremap <leader>b :make<CR>
nnoremap <leader>q :copen<CR>
nnoremap <leader>e :Lexplore<CR>
nnoremap <leader>n :nohlsearch<CR>
nnoremap ]q :cnext<CR>
nnoremap [q :cprevious<CR>

let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_winsize = 25

" Background diagnostics: installed by apt, with no plugin manager or LSP setup.
" Check on open/save/InsertLeave, so checks do not interrupt insert-mode pairs.
let g:ale_linters_explicit = 1
let g:ale_linters = {'c': ['cc'], 'cpp': ['cc'], 'python': ['flake8']}
let g:ale_c_cc_executable = 'clang'
let g:ale_cpp_cc_executable = 'clang++'
let g:ale_c_cc_options = '-std=c17 -Wall -Wextra'
let g:ale_cpp_cc_options = '-std=c++17 -Wall -Wextra'
let g:ale_c_parse_compile_commands = 1
let g:ale_c_parse_makefile = 0
let g:ale_python_flake8_use_global = 1
let g:ale_python_flake8_options = '--select=E9,F63,F7,F82'
let g:ale_lint_on_enter = 1
let g:ale_lint_on_save = 1
let g:ale_lint_on_insert_leave = 1
let g:ale_lint_on_text_changed = 'never'
let g:ale_sign_error = '>>'
let g:ale_sign_warning = '!!'
let g:ale_set_signs = 1
let g:ale_set_highlights = 1
let g:ale_echo_cursor = 1
let g:ale_echo_delay = 200
let g:ale_virtualtext_cursor = 0
let g:ale_set_loclist = 1
let g:ale_set_quickfix = 0
let g:ale_open_list = 0
let g:ale_fix_on_save = 0
let g:ale_completion_enabled = 0
nnoremap <silent> ]d :ALENextWrap<CR>
nnoremap <silent> [d :ALEPreviousWrap<CR>

if executable('rg')
    set grepprg=rg\ --vimgrep\ --smart-case\ --
    set grepformat=%f:%l:%c:%m
endif

" Native insert-mode pairs for every filetype; no downloaded plugin required.
let g:linux_env_auto_pairs = get(g:, 'linux_env_auto_pairs', 1)
let s:pairs = {'(': ')', '[': ']', '{': '}', '"': '"', "'": "'", '`': '`'}
function! s:PairsEnabled() abort
    return g:linux_env_auto_pairs && !&paste && &buftype ==# ''
endfunction

function! s:PairEscaped() abort
    let l:before = strpart(getline('.'), 0, col('.') - 1)
    return strlen(matchstr(l:before, '\\\+$')) % 2
endfunction

function! s:PairInString() abort
    " Syntax highlighting may lag behind fast typing or macros. Scan the current
    " line as well, so a single quote inside a double-quoted string stays literal.
    let l:before = strpart(getline('.'), 0, col('.') - 1)
    let l:quote = ''
    let l:escaped = 0
    for l:char in split(l:before, '\zs')
        if l:escaped
            let l:escaped = 0
        elseif l:char ==# '\'
            let l:escaped = 1
        elseif empty(l:quote) && index(['"', "'", '`'], l:char) >= 0
            let l:quote = l:char
        elseif l:char ==# l:quote
            let l:quote = ''
        endif
    endfor
    if !empty(l:quote)
        return 1
    endif
    " Also recognize multiline strings when the filetype supplies syntax rules.
    return col('.') > 1 && l:before !~# '["''`]$'
                \ && synIDattr(synID(line('.'), col('.') - 1, 1), 'name') =~? 'string\|character'
endfunction

function! s:PairOpen(key) abort
    if !s:PairsEnabled() || s:PairEscaped()
        return a:key
    endif
    let l:before = strpart(getline('.'), 0, col('.') - 1)
    let l:next = strpart(getline('.'), col('.') - 1, 1)
    if index(['"', "'", '`'], a:key) >= 0
        if l:next ==# a:key
            return "\<Right>"
        endif
        " After two typed quotes, the third opens a Python triple-quoted string.
        if &filetype ==# 'python' && a:key !=# '`' && l:before =~# escape(repeat(a:key, 2), '\') . '$'
            return repeat(a:key, 4) . "\<Left>\<Left>\<Left>"
        endif
        " A quote within another string, or an apostrophe within a word, is literal.
        if s:PairInString() || (l:before =~# '\k$' && l:next =~# '\k')
            return a:key
        endif
    endif
    return a:key . s:pairs[a:key] . "\<Left>"
endfunction

function! s:PairClose(key) abort
    if s:PairsEnabled() && !s:PairEscaped() && strpart(getline('.'), col('.') - 1, 1) ==# a:key
        return "\<Right>"
    endif
    return a:key
endfunction

function! s:PairBackspace() abort
    let l:before = strpart(getline('.'), 0, col('.') - 1)
    let l:previous = strcharpart(l:before, strchars(l:before) - 1, 1)
    let l:next = strpart(getline('.'), col('.') - 1, 1)
    if s:PairsEnabled() && has_key(s:pairs, l:previous) && s:pairs[l:previous] ==# l:next
                \ && strlen(matchstr(strpart(l:before, 0, strlen(l:before) - 1), '\\\+$')) % 2 == 0
        return "\<BS>\<Del>"
    endif
    return "\<BS>"
endfunction

function! s:PairEnter() abort
    let l:previous = strpart(getline('.'), col('.') - 2, 1)
    let l:next = strpart(getline('.'), col('.') - 1, 1)
    if s:PairsEnabled() && !pumvisible() && !s:PairInString()
                \ && index(['(', '[', '{'], l:previous) >= 0 && s:pairs[l:previous] ==# l:next
        " Use the language's indentation rules; plain text gets one extra level.
        let l:indent = empty(&indentexpr) && !&cindent && !&smartindent ? "\<C-t>" : ''
        return "\<CR>\<C-o>O" . l:indent
    endif
    return "\<CR>"
endfunction

" Evaluate after pending text is inserted, including fast typing and macros.
inoremap <silent> ( <C-r>=<SID>PairOpen('(')<CR>
inoremap <silent> [ <C-r>=<SID>PairOpen('[')<CR>
inoremap <silent> { <C-r>=<SID>PairOpen('{')<CR>
inoremap <silent> " <C-r>=<SID>PairOpen('"')<CR>
inoremap <silent> ' <C-r>=<SID>PairOpen("'")<CR>
inoremap <silent> ` <C-r>=<SID>PairOpen('`')<CR>
inoremap <silent> ) <C-r>=<SID>PairClose(')')<CR>
inoremap <silent> ] <C-r>=<SID>PairClose(']')<CR>
inoremap <silent> } <C-r>=<SID>PairClose('}')<CR>
inoremap <silent> <BS> <C-r>=<SID>PairBackspace()<CR>
inoremap <silent><expr> <CR> <SID>PairEnter()

" Insert a header only for a new file. Existing files are never rewritten.
let g:linux_env_author = get(g:, 'linux_env_author', 'chendatao')
let g:linux_env_email = get(g:, 'linux_env_email', 'peacecdt@gmail.com')
function! s:NewSourceHeader() abort
    if line('$') != 1 || getline(1) !=# '' || &buftype !=# ''
        return
    endif
    let l:ext = tolower(expand('%:e'))
    let l:meta = ['File Name: ' . expand('%:t'),
                \ 'Author: ' . g:linux_env_author,
                \ 'Mail: ' . g:linux_env_email,
                \ 'Created Time: ' . strftime('%Y-%m-%d %H:%M:%S %Z')]
    if l:ext ==# 'py'
        let l:lines = ['#!/usr/bin/env python3', '# -*- coding: utf-8 -*-', '# ' . repeat('*', 70)]
        call extend(l:lines, map(copy(l:meta), '''# > '' . v:val'))
        call extend(l:lines, ['# ' . repeat('*', 70), '', 'import sys', 'from pathlib import Path', ''])
    else
        let l:lines = ['/' . repeat('*', 71)]
        call extend(l:lines, map(copy(l:meta), ''' * > '' . v:val'))
        call extend(l:lines, [' ' . repeat('*', 70) . '/', ''])
        if l:ext ==# 'c'
            call extend(l:lines, ['#include <stdio.h>', '#include <stdlib.h>', '#include <string.h>', ''])
        else
            call extend(l:lines, ['#include <iostream>', '#include <cstdio>', '#include <cstdlib>',
                        \ '#include <queue>', '#include <stack>', '#include <algorithm>',
                        \ '#include <string>', '#include <map>', '#include <set>', '#include <vector>',
                        \ 'using namespace std;', ''])
        endif
    endif
    call setline(1, l:lines)
    call cursor(len(l:lines), 1)
endfunction

" :make on Python checks syntax. It does not execute the edited program.
" Resolve an interpreter only when explicitly running :make, so a newly created
" .venv also works. shellescape(..., 1) protects shell and Vim special characters.
function! s:PythonMake() abort
    let l:directory = expand('%:p:h')
    let l:python = ''
    while !empty(l:directory)
        let l:candidate = l:directory . '/.venv/bin/python'
        if executable(l:candidate)
            let l:python = l:candidate
            break
        endif
        let l:parent = fnamemodify(l:directory, ':h')
        if l:parent ==# l:directory
            break
        endif
        let l:directory = l:parent
    endwhile
    if empty(l:python) && !empty($VIRTUAL_ENV) && executable($VIRTUAL_ENV . '/bin/python')
        let l:python = $VIRTUAL_ENV . '/bin/python'
    endif
    if empty(l:python)
        let l:python = exepath('python3')
    endif
    if empty(l:python)
        let l:python = 'python3'
    endif
    let &l:makeprg = shellescape(l:python, 1) . ' -m py_compile %:S'
    let &l:errorformat = '%A  File "%f"\, line %l%.%#,%C    %.%#,%Z%m'
endfunction

augroup linux_env
    autocmd!
    autocmd BufNewFile *.c,*.cpp,*.cc,*.cxx,*.py call <SID>NewSourceHeader()
    autocmd FileType c,cpp setlocal suffixesadd=.h,.hpp,.hh,.hxx
    autocmd FileType c,cpp setlocal makeprg=cmake\ --build\ build
    autocmd FileType python call <SID>PythonMake()
    autocmd QuickFixCmdPre make if &filetype ==# 'python' | call <SID>PythonMake() | endif
    autocmd FileType sh,yaml,json setlocal shiftwidth=2 softtabstop=2
    autocmd FileType make setlocal noexpandtab
augroup END

" Personal settings are loaded only from this explicit file in your home.
if filereadable(expand('~/.vimrc.local'))
    execute 'source ' . fnameescape(expand('~/.vimrc.local'))
endif
